# Optional: authenticate token requests with your own Docker Hub account so
# pulls use your account's higher rate-limit bucket instead of the shared
# anonymous-per-IP bucket that all Vercel egress traffic falls into.
# Use a Personal Access Token (Account Settings -> Security), NOT your password.
DOCKER_USERNAME=your-dockerhub-username
DOCKER_PASSWORD=dckr_pat_xxxxxxxxxxxxxxxxxxxxx

# Optional: point at a different upstream registry (defaults to Docker Hub).
# UPSTREAM_REGISTRY=https://registry-1.docker.io
# UPSTREAM_AUTH=https://auth.docker.io
# UPSTREAM_SERVICE=registry.docker.io
